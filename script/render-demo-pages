#!/usr/bin/env swift
// Renders a fictional duplex scan for screenshots and demos: page-001.png .. page-004.png, the fronts
// and backs of a two-sheet auto service invoice. Every name, address, number, and VIN is made up.
// Each page is a 300 dpi frame the way the FF-680W returns it: a short leading edge, the paper, a
// trailing-edge shadow, a band of gray backing, then pure white fill, so PageProcessor.crop works on it.
// Usage: script/render-demo-pages <output-dir>
import CoreGraphics
import CoreText
import Foundation
import ImageIO
import UniformTypeIdentifiers

let dpi: CGFloat = 300
let frame = (width: 2544, height: 4642)
let paperTop = 12, paperHeight = 3300, shadowHeight = 12, backingHeight = 105

func gray(_ level: CGFloat) -> CGColor { CGColor(srgbRed: level, green: level, blue: level, alpha: 1) }
func rgb(_ hex: UInt32, _ alpha: CGFloat = 1) -> CGColor {
    CGColor(srgbRed: CGFloat((hex >> 16) & 0xFF) / 255, green: CGFloat((hex >> 8) & 0xFF) / 255,
            blue: CGFloat(hex & 0xFF) / 255, alpha: alpha)
}

let ink = rgb(0x26262A)
let rule = rgb(0x55555C)
let teal = rgb(0x1E7A78)
let amber = rgb(0xE59A2F)
let stampRed = rgb(0xC0302A, 0.82)

/// Draws on a US Letter page in points, top-down, the way a form is laid out.
struct Pen {
    let context: CGContext
    let pageHeight: CGFloat = 792

    func y(_ top: CGFloat) -> CGFloat { pageHeight - top }

    @discardableResult
    func text(_ string: String, _ x: CGFloat, _ top: CGFloat, size: CGFloat = 8.5, font: String = "Menlo-Regular",
              color: CGColor = ink, align: CGFloat = 0, tracking: CGFloat = 0) -> CGFloat {
        let ctFont = CTFontCreateWithName(font as CFString, size, nil)
        let attributes: [NSAttributedString.Key: Any] = [
            .init(kCTFontAttributeName as String): ctFont, .init(kCTForegroundColorAttributeName as String): color,
            .init(kCTKernAttributeName as String): tracking,
        ]
        let line = CTLineCreateWithAttributedString(NSAttributedString(string: string, attributes: attributes))
        let width = CTLineGetTypographicBounds(line, nil, nil, nil)
        context.textPosition = CGPoint(x: x - CGFloat(width) * align, y: y(top) - CTFontGetAscent(ctFont))
        CTLineDraw(line, context)
        return CGFloat(width)
    }

    func line(_ x1: CGFloat, _ top1: CGFloat, _ x2: CGFloat, _ top2: CGFloat, width: CGFloat = 0.6, color: CGColor = rule) {
        context.setStrokeColor(color)
        context.setLineWidth(width)
        context.move(to: CGPoint(x: x1, y: y(top1)))
        context.addLine(to: CGPoint(x: x2, y: y(top2)))
        context.strokePath()
    }

    func box(_ x: CGFloat, _ top: CGFloat, _ width: CGFloat, _ height: CGFloat, width lineWidth: CGFloat = 0.6, fill: CGColor? = nil) {
        let rect = CGRect(x: x, y: y(top + height), width: width, height: height)
        if let fill {
            context.setFillColor(fill)
            context.fill(rect)
        }
        context.setStrokeColor(rule)
        context.setLineWidth(lineWidth)
        context.stroke(rect)
    }

    /// Wraps `string` to `width` points in the body font and returns the top of the next line.
    func paragraph(_ string: String, _ x: CGFloat, _ top: CGFloat, width: CGFloat, size: CGFloat, leading: CGFloat,
                   font: String = "Menlo-Regular") -> CGFloat {
        let ctFont = CTFontCreateWithName(font as CFString, size, nil)
        let advance = CTFontGetAdvancesForGlyphs(ctFont, .horizontal, [CTFontGetGlyphWithName(ctFont, "M" as CFString)], nil, 1)
        let perLine = max(10, Int(width / CGFloat(advance)))
        var lines: [String] = [], current = ""
        for word in string.split(separator: " ") {
            if current.count + word.count + 1 > perLine, !current.isEmpty {
                lines.append(current)
                current = ""
            }
            current += current.isEmpty ? String(word) : " \(word)"
        }
        if !current.isEmpty { lines.append(current) }
        var top = top
        for line in lines {
            text(line, x, top, size: size, font: font)
            top += leading
        }
        return top
    }
}

func logo(_ pen: Pen, x: CGFloat, top: CGFloat, size: CGFloat) {
    let context = pen.context
    let rect = CGRect(x: x, y: pen.y(top + size), width: size, height: size)
    context.saveGState()
    context.addEllipse(in: rect)
    context.clip()
    context.setFillColor(teal)
    context.fill(rect)
    context.setFillColor(amber)
    context.fillEllipse(in: CGRect(x: rect.midX + size * 0.04, y: rect.midY + size * 0.02, width: size * 0.3, height: size * 0.3))
    context.setFillColor(rgb(0xF4F1E8))
    let peaks: [(CGFloat, CGFloat)] = [(0, 0.28), (0.3, 0.62), (0.45, 0.48), (0.62, 0.7), (1, 0.3)]
    context.move(to: CGPoint(x: rect.minX, y: rect.minY))
    for (px, py) in peaks { context.addLine(to: CGPoint(x: rect.minX + size * px, y: rect.minY + size * py)) }
    context.addLine(to: CGPoint(x: rect.maxX, y: rect.minY))
    context.fillPath()
    context.restoreGState()
    context.setStrokeColor(teal)
    context.setLineWidth(1.2)
    context.strokeEllipse(in: rect.insetBy(dx: -2.5, dy: -2.5))
}

func stamp(_ pen: Pen, centerX: CGFloat, centerTop: CGFloat) {
    let context = pen.context
    context.saveGState()
    context.translateBy(x: centerX, y: pen.y(centerTop))
    context.rotate(by: 0.21)
    context.setStrokeColor(stampRed)
    context.setLineWidth(2.4)
    context.stroke(CGRect(x: -78, y: -30, width: 156, height: 60))
    context.setLineWidth(0.9)
    context.stroke(CGRect(x: -72, y: -24, width: 144, height: 48))
    // Shifted so the stamp's center is the pen's (0, 0).
    context.translateBy(x: 0, y: -pen.pageHeight)
    pen.text("PAID", 0, -21, size: 24, font: "Helvetica-Bold", color: stampRed, align: 0.5, tracking: 4)
    pen.text("07 OCT 2026", 0, 8, size: 9, font: "Helvetica-Bold", color: stampRed, align: 0.5, tracking: 1.5)
    context.restoreGState()
}

