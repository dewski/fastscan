func back(_ pen: Pen) {
    pen.text("LIMITED WARRANTY AND TERMS OF SERVICE", 306, 40, size: 11, font: "Menlo-Bold", align: 0.5, tracking: 0.5)
    pen.text("PLEASE READ CAREFULLY. THESE TERMS ARE PART OF YOUR REPAIR ORDER.", 306, 58, size: 7, align: 0.5)
    pen.line(left, 72, right, 72, width: 0.9)
    let columnWidth: CGFloat = 250, gutter: CGFloat = 32
    var column = 0
    var top: CGFloat = 84
    for (index, (heading, body)) in terms.enumerated() {
        if index == terms.count / 2 {
            column = 1
            top = 84
        }
        let x = left + CGFloat(column) * (columnWidth + gutter)
        pen.text("\(index + 1). \(heading)", x, top, size: 7.5, font: "Menlo-Bold")
        top = pen.paragraph(body, x, top + 11, width: columnWidth, size: 6.4, leading: 8.9) + 8
    }
    pen.line(left, 740, right, 740, width: 0.6)
    pen.text("SIERRA RIDGE AUTO CARE  -  CALIFORNIA BAR NO. ARD 000000", 306, 748, size: 6.5, align: 0.5)
}

/// Faint per-pixel grain, drawn as one tile so the paper isn't perfectly flat like a render.
func grain() -> CGImage {
    let side = 256
    var pixels = [UInt8](repeating: 0, count: side * side)
    var state: UInt32 = 0x5EED
    for i in pixels.indices {
        state = state &* 1_664_525 &+ 1_013_904_223
        pixels[i] = UInt8(truncatingIfNeeded: state >> 24)
    }
    let context = CGContext(data: &pixels, width: side, height: side, bitsPerComponent: 8, bytesPerRow: side,
                            space: CGColorSpaceCreateDeviceGray(), bitmapInfo: 0)!
    return context.makeImage()!
}

func render(_ draw: (Pen) -> Void, to url: URL) throws {
    let context = CGContext(data: nil, width: frame.width, height: frame.height, bitsPerComponent: 8, bytesPerRow: 0,
                            space: CGColorSpace(name: CGColorSpace.sRGB)!, bitmapInfo: CGImageAlphaInfo.noneSkipLast.rawValue)!
    func band(_ top: Int, _ height: Int, _ color: CGColor) {
        context.setFillColor(color)
        context.fill(CGRect(x: 0, y: frame.height - top - height, width: frame.width, height: height))
    }
    band(0, frame.height, gray(1))
    band(0, paperTop, gray(0.42))
    band(paperTop, paperHeight, rgb(0xF5F2EA))
    band(paperTop + paperHeight, shadowHeight, gray(0.3))
    band(paperTop + paperHeight + shadowHeight, backingHeight, gray(0.82))

    let paper = CGRect(x: 0, y: frame.height - paperTop - paperHeight, width: frame.width, height: paperHeight)
    context.saveGState()
    context.clip(to: paper)
    context.setAlpha(0.05)
    context.draw(grain(), in: CGRect(x: 0, y: 0, width: 256, height: 256), byTiling: true)
    context.setAlpha(1)
    context.translateBy(x: 0, y: paper.minY)
    context.scaleBy(x: dpi / 72, y: dpi / 72)
    draw(Pen(context: context))
    context.restoreGState()

    guard let destination = CGImageDestinationCreateWithURL(url as CFURL, UTType.png.identifier as CFString, 1, nil) else {
        throw CocoaError(.fileWriteUnknown, userInfo: [NSFilePathErrorKey: url.path])
    }
    CGImageDestinationAddImage(destination, context.makeImage()!, [kCGImagePropertyDPIWidth: dpi, kCGImagePropertyDPIHeight: dpi] as CFDictionary)
    guard CGImageDestinationFinalize(destination) else { throw CocoaError(.fileWriteUnknown, userInfo: [NSFilePathErrorKey: url.path]) }
}

guard CommandLine.arguments.count == 2 else {
    FileHandle.standardError.write(Data("usage: render-demo-pages <output-dir>\n".utf8))
    exit(64)
}
let output = URL(filePath: CommandLine.arguments[1], directoryHint: .isDirectory)
try FileManager.default.createDirectory(at: output, withIntermediateDirectories: true)
for (number, page) in [frontOne, back, frontTwo, back].enumerated() {
    let url = output.appending(path: String(format: "page-%03d.png", number + 1))
    try render(page, to: url)
    print(url.path)
}
