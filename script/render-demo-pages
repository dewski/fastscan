    pen.text("SIERRA RIDGE AUTO CARE", left + 68, 40, size: 17, font: "Helvetica-Bold", color: teal, tracking: 0.6)
    pen.text("Independent Subaru & Import Service", left + 68, 60, size: 8.5, font: "Helvetica-Oblique")
    pen.text("1480 Granite Bay Road  Truckee, CA 96161", left + 68, 73, size: 8)
    pen.text("(530) 555-0142    sierraridgeautocare.com", left + 68, 84, size: 8)

    pen.box(404, 36, 168, 60, width: 0.9)
    pen.text("REPAIR ORDER / INVOICE", 488, 42, size: 9, font: "Menlo-Bold", align: 0.5)
    pen.line(404, 55, 572, 55)
    pen.text("NO.", 410, 60, size: 8)
    pen.text("0048213", 566, 60, size: 8, font: "Menlo-Bold", align: 1)
    pen.text("DATE", 410, 71, size: 8)
    pen.text("07 OCT 2026", 566, 71, size: 8, font: "Menlo-Bold", align: 1)
    pen.text("PAGE", 410, 82, size: 8)
    pen.text("\(page) OF 2", 566, 82, size: 8, align: 1)
}

func customerBlock(_ pen: Pen) {
    pen.box(left, 106, 260, 74)
    pen.text("CUSTOMER", left + 6, 110, size: 6.5, font: "Menlo-Bold")
    pen.text("ALEX RIVERA", left + 6, 122, size: 9, font: "Menlo-Bold")
    pen.text("742 JUNIPER HOLLOW LN", left + 6, 135, size: 8.5)
    pen.text("GRASS VALLEY, CA 95945", left + 6, 147, size: 8.5)
    pen.text("HOME (530) 555-0187", left + 6, 162, size: 8)

    pen.box(312, 106, 260, 74)
    pen.text("VEHICLE", 318, 110, size: 6.5, font: "Menlo-Bold")
    pen.text("2021 SUBARU OUTBACK LIMITED", 318, 122, size: 9, font: "Menlo-Bold")
    pen.text("VIN    4S4DEMXXXM0000000", 318, 135, size: 8.5)
    pen.text("PLATE  DEMO 123    COLOR  AUTUMN GREEN", 318, 147, size: 8)
    pen.text("MILES IN 30,118    MILES OUT 30,121", 318, 162, size: 8)

    let columns: [(String, String)] = [("ADVISOR", "J. OKAFOR"), ("TECH", "214"), ("OPENED", "07OCT26 07:42"), ("READY", "07OCT26 15:10"), ("TAG", "T-58")]
    pen.box(left, 188, right - left, 26)
    var x = left
    for (index, (label, value)) in columns.enumerated() {
        if index > 0 { pen.line(x, 188, x, 214) }
        pen.text(label, x + 6, 192, size: 6.5, font: "Menlo-Bold")
        pen.text(value, x + 6, 202, size: 8.5)
        x += (right - left) / CGFloat(columns.count)
    }
}

struct Item {
    var code: String
    var description: String
    var quantity: String = ""
    var amount: String = ""
}

func table(_ pen: Pen, top: CGFloat, sections: [(title: String, items: [Item])], bottom: CGFloat) {
    pen.box(left, top, right - left, bottom - top)
    pen.box(left, top, right - left, 16, fill: rgb(0xE7E3D8))
    let columns: [CGFloat] = [left, left + 70, 452, 500]
    for x in columns.dropFirst() { pen.line(x, top, x, bottom) }
    pen.text("CODE", left + 6, top + 4, size: 7, font: "Menlo-Bold")
    pen.text("DESCRIPTION", left + 76, top + 4, size: 7, font: "Menlo-Bold")
    pen.text("QTY/HRS", 476, top + 4, size: 7, font: "Menlo-Bold", align: 0.5)
    pen.text("AMOUNT", 566, top + 4, size: 7, font: "Menlo-Bold", align: 1)
    var row = top + 24
    for section in sections {
        pen.text(section.title, left + 76, row, size: 9, font: "Menlo-Bold")
        row += 14
        for item in section.items {
            pen.text(item.code, left + 6, row, size: 8)
            pen.text(item.description, left + 76, row, size: 8)
            pen.text(item.quantity, 494, row, size: 8, align: 1)
            pen.text(item.amount, 566, row, size: 8, align: 1)
            row += 12
        }
        row += 4
        pen.line(left + 70, row - 2, right, row - 2, width: 0.3)
        row += 8
    }
}

